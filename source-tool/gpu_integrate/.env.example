# Modal HTTP endpoints after `modal deploy` (copy from CLI output)
SAM3_MODAL_VISUAL_URL=https://YOUR_WORKSPACE--sam3-cvat-sam3-visual.modal.run
SAM3_MODAL_TEXT_URL=https://YOUR_WORKSPACE--sam3-cvat-sam3-text.modal.run
SAM3_MODAL_HEALTH_URL=https://YOUR_WORKSPACE--sam3-cvat-sam3-health.modal.run

# Dashboard → Settings → Proxy Auth Tokens  (or: modal workspace proxy-tokens)
MODAL_PROXY_KEY=wk-...
MODAL_PROXY_SECRET=ws-...

# Hugging Face (local tests / documentation; Modal uses the `huggingface` secret)
HF_TOKEN=hf_...

# Optional
SAM3_TIMEOUT_SEC=170
